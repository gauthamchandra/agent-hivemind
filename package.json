{
  "name": "agent-hivemind",
  "version": "0.0.1",
  "description": "Bun-powered agent hivemind application",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "hivemind-svc": "bun run src/index.ts",
    "hivemind": "bun run src/cli/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "bunx tsc --noEmit && bunx biome check --error-on-warnings .",
    "lint:fix": "bunx tsc --noEmit && bunx biome check --write --error-on-warnings .",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format .",
    "prepare": "husky"
  },
  "author": "Gautham Chandra",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.4"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "umzug": "3.8.2"
  }
}
