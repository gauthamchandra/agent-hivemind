# Dependencies
node_modules/

# Coverage from `bun run test:coverage`
coverage/

# Local service record. `HIVEMIND_DATA` defaults to this directory.
.hivemind/

# Bun loads `.env` itself
.env
.env.*

# Personal agent overrides. Shared permissions stay in `.claude/settings.json`.
.context/
.claude/settings.local.json

# Layer-rule fixtures. `biome check .` skips gitignored paths, so a test can
# write one without failing a lint that is running at the same time.
*.fixture.ts
