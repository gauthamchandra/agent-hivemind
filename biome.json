{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/*.config.js",
      "!**/commitlint.config.js",
      "!**/.agents/skills"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "plugins": [
    {
      "path": "./biome/no-platform-name.grit",
      "includes": ["src/core/**"],
      "resolutionKind": "config"
    },
    {
      "path": "./biome/no-down-migration.grit",
      "includes": ["src/**"],
      "resolutionKind": "config"
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noVar": "error"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "useShorthandAssign": "error",
        "noNonNullAssertion": "warn",
        "noInferrableTypes": "off",
        "useConsistentObjectDefinitions": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteProperties": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "lineWidth": 120,
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.ts", "!src/**/*.test.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": { "maxLines": 100 }
            }
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 300 }
            }
          }
        }
      }
    },
    {
      "includes": ["src/domain/**", "!src/domain/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/policy",
                      "**/policy/**",
                      "**/ports",
                      "**/ports/**",
                      "**/core",
                      "**/core/**",
                      "**/storage",
                      "**/storage/**",
                      "**/platform",
                      "**/platform/**",
                      "**/notify",
                      "**/notify/**",
                      "**/identity",
                      "**/identity/**",
                      "**/http",
                      "**/http/**",
                      "**/console",
                      "**/console/**",
                      "**/cli",
                      "**/cli/**",
                      "**/conformance",
                      "**/conformance/**"
                    ],
                    "message": "This layer cannot import that layer."
                  }
                ]
              }
            }
          }
        }
      }
    },
