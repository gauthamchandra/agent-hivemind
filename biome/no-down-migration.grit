language js

or {
  `$receiver.down($args)`,
  `$receiver.down()`,
  `$receiver?.down($args)`,
  `$receiver?.down()`,
  `$receiver.rollback($args)`,
  `$receiver.rollback()`,
  `$receiver?.rollback($args)`,
  `$receiver?.rollback()`
} as $call where {
  register_diagnostic(span=$call, message="Migrations are forward only. Do not call down or rollback.", severity="error")
}
